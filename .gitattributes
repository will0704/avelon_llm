# Every text file is LF in the repository and in every working tree.
# eol=lf overrides each machine's core.autocrlf, so the macOS and Windows
# checkouts commit identical bytes instead of fighting over line endings.
* text=auto eol=lf

# Trained model artifacts. EOL translation would corrupt these silently —
# the service would fall back to rules instead of erroring.
*.pt  binary
*.pkl binary

*.png  binary
*.jpg  binary
*.jpeg binary
